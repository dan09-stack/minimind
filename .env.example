# Database (use Neon.tech for production)
DATABASE_URL="postgresql://username:password@localhost:5432/miniminds"

# NextAuth.js (update with your Netlify URL)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# OpenAI
OPENAI_API_KEY="your-openai-api-key"

# Stripe (update price IDs after creating products)
STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"
STRIPE_SECRET_KEY="your-stripe-secret-key"

# Email (for password reset - optional)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="example-smtp-user"
SMTP_PASSWORD="example-smtp-password"

# For Netlify deployment, set these in Netlify dashboard:
# - Go to Site settings → Environment variables
# - Add all variables above
# - Update NEXTAUTH_URL to: https://your-site-name.netlify.app
